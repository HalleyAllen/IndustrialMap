# 后端环境变量示例
# 复制为 .env 后按需修改

# SQLite 配置库路径（存储 Neo4j 与 AI 的连接信息）
SETTINGS_DB_PATH=./data/industrialmap_settings.db

# CORS 白名单（JSON 列表）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 默认 Neo4j 配置（仅在 SQLite 没有记录时作为首次默认值；之后请到 Web UI 配置）
DEFAULT_NEO4J_URI=bolt://localhost:7687
DEFAULT_NEO4J_USER=neo4j
DEFAULT_NEO4J_PASSWORD=neo4j
DEFAULT_NEO4J_DATABASE=neo4j

# === Neo4j / AI 配置现在都在 Web UI 上填写 ===
# 启动后访问 http://127.0.0.1:5173/settings，在「Neo4j 数据库」和「AI 服务」两个 Tab 中填写并保存。
# 支持任意兼容 OpenAI /chat/completions 协议的 LLM：OpenAI / DeepSeek / 通义千问 / 智谱 / Ollama / 自建网关等。